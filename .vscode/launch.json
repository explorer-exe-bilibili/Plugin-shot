{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (Windows, MSVC)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Windows/bin/Plugin-shot.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Windows/bin",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "CMake: build (debug)"
        },
        {
            "name": "Debug (Linux, gdb)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/Linux/bin/Plugin-shot",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Linux/bin",
            "environment": [],
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "CMake: build (debug)"
        }
    ]
}