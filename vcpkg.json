{
  "name": "plugin-shot",
  "version-string": "0.1.0",
  "description": "Plugin-based screenshot tool with a stable C plugin ABI",
  "dependencies": [
    "nlohmann-json",
    {
      "name": "opencv4",
      "default-features": false,
      "features": [
        "jpeg",
        "png",
        "tiff",
        "webp"
      ]
    },
    {
      "name": "imgui",
      "features": [
        "win32-binding",
        "opengl3-binding"
      ]
    },
    "spdlog"
  ]
}
